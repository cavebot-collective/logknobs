   ],
   "args": [
    "--graph",
    "--all"
   ],
   "format": "%C(cyan)%h%Creset - %C(bold yellow)%d%Creset %s %C(blue)(%ar) %C(magenta)%an%Creset"
  },
  {
   "id": "ld",
   "class": "verbatim",
   "sources": [
    {
     "who": "Tom Limoncelli",
     "url": "https://everythingsysadmin.com/2016/05/10-git-aliases.html",
     "date": "2016-05-05"
    }
   ],
   "args": [
    "--decorate",
    "--date=short",
    "--graph"
   ],
   "format_as_written_in_gitconfig": "%C(yellow)%h\\\\ %C(green)%ad%Cred%d\\\\ %Creset%s%Cblue\\\\ [%cn]",
   "format": "%C(yellow)%h %C(green)%ad%Cred%d %Creset%s%Cblue [%cn]",
   "note": "gitconfig '\\\\ ' is unescaped twice (config parser, then alias split_cmdline) to a plain space"
  },
  {
   "id": "ls",
   "class": "verbatim",
   "sources": [
    {
     "who": "Tom Limoncelli",
     "url": "https://everythingsysadmin.com/2016/05/10-git-aliases.html",
     "date": "2016-05-05"
    }
   ],
   "args": [
    "--decorate",
    "--date=relative"
   ],
   "format": "%C(green)%h %C(yellow)[%ad]%Cred%d %Creset%s%Cblue [%cn]"
  },
  {
   "id": "smartlog",
   "class": "verbatim-reassembled",
   "sources": [
