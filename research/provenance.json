     "who": "Jesse Squires",
     "url": "https://www.jessesquires.com/blog/customizing-git-log/",
     "date": "2017-08-08"
    }
   ],
   "args": [
    "--graph"
   ],
   "format": "commit: %C(bold red)%h%Creset %C(red)<%H>%Creset %C(bold magenta)%d %Creset%ndate: %C(bold yellow)%cd %Creset%C(yellow)%cr%Creset%nauthor: %C(bold blue)%an%Creset %C(blue)<%ae>%Creset%n%C(cyan)%s%n%Creset",
